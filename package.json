{
  "name": "ssc0536-g6",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=10.28.1 <11"
  },
  "scripts": {
    "start": "bash scripts/start.sh",
    "stop": "bash scripts/stop.sh",
    "dev": "pnpm --filter @ssc0536/common build && pnpm --parallel --filter @ssc0536/common --filter @ssc0536/frontend --filter @ssc0536/backend dev",
    "dev:frontend": "pnpm --filter @ssc0536/common build && pnpm --parallel --filter @ssc0536/common --filter @ssc0536/frontend dev",
    "dev:backend": "pnpm --filter @ssc0536/common build && pnpm --parallel --filter @ssc0536/common --filter @ssc0536/backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @ssc0536/common build && pnpm -r typecheck",
    "test": "pnpm --filter @ssc0536/common build && pnpm -r --if-present test",
    "test:unit": "pnpm --filter @ssc0536/common build && pnpm -r --if-present test:unit",
    "test:integration": "pnpm --filter @ssc0536/common build && pnpm --filter @ssc0536/backend test:integration",
    "validate:repo": "node scripts/validate-repository.mjs",
    "db:validate": "pnpm --filter @ssc0536/backend exec prisma validate",
    "db:seed": "pnpm --filter @ssc0536/backend db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --build --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:catalogos": "pnpm --filter @ssc0536/backend db:catalogos",
    "db:indicadores-demo": "pnpm --filter @ssc0536/backend db:indicadores-demo",
    "db:generate": "pnpm --filter @ssc0536/backend db:generate",
    "db:migrate": "pnpm --filter @ssc0536/backend db:migrate",
    "db:deploy": "pnpm --filter @ssc0536/backend db:deploy",
    "db:studio": "pnpm --filter @ssc0536/backend db:studio",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f backend postgres",
    "prepare": "pnpm --filter @ssc0536/common build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^16.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1",
    "typescript-eslint": "^8.72.2"
  }
}
