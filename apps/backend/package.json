{
  "name": "@ssc0536/backend",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm db:generate && nest start --watch",
    "build": "pnpm db:generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm db:generate && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^18.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@types/node": "^24.0.0",
    "prisma": "7.10.1"
  }
}
