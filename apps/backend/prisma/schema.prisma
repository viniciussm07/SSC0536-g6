generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Segmento {
  id              Int                      @id @default(autoincrement())
  chave           String                   @unique
  nome            String
  /// completo ou basico
  nivelCadastro   String                   @map("nivel_cadastro")
  empreendimentos EmpreendimentoSegmento[]
  grupos          CatalogoGrupo[]

  @@map("segmento")
}

model Empreendimento {
  id                   Int                       @id @default(autoincrement())
  nomeFantasia         String                    @map("nome_fantasia")
  razaoSocial          String?                   @map("razao_social")
  /// Nulo permitido; unicidade depende de confirmação do OTO.
  cnpj                 String?
  idOrigem             String?                   @map("id_origem")
  tipoHospedagem       String?                   @map("tipo_hospedagem")
  /// Mapeamento entre tipo de hospedagem e categoria ainda a validar.
  categoriaIndicador   String?                   @map("categoria_indicador")
  endereco             String?
  /// urbana ou rural
  zona                 String?
  /// PostGIS; leitura/escrita por SQL parametrizado no Prisma 7.
  localizacao          Unsupported("geography")?
  dataInicioAtividades DateTime?                 @map("data_inicio_atividades") @db.Date
  /// ativo ou encerrado
  situacao             String
  dataEncerramento     DateTime?                 @map("data_encerramento") @db.Date
  segmentos            EmpreendimentoSegmento[]
  contatos             Contato[]
  cadastur             Cadastur[]
  usuarios             UsuarioEmpreendimento[]
  inventarios          InventarioVersao[]
  respostas            Resposta[]
  coletasDiarias       ColetaDiaria[]
  destinatarios        PesquisaDestinatario[]

  @@map("empreendimento")
}

model EmpreendimentoSegmento {
  empreendimentoId Int            @map("empreendimento_id")
  segmentoId       Int            @map("segmento_id")
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Restrict)
  segmento         Segmento       @relation(fields: [segmentoId], references: [id], onDelete: Restrict)

  @@id([empreendimentoId, segmentoId])
  @@index([segmentoId])
  @@map("empreendimento_segmento")
}

model Contato {
  id               Int            @id @default(autoincrement())
  empreendimentoId Int            @map("empreendimento_id")
  /// telefone, email, site ou rede_social
  tipo             String
  valor            String
  /// publico ou interno
  finalidade       String
  responsavelNome  String?        @map("responsavel_nome")
  responsavelCargo String?        @map("responsavel_cargo")
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Restrict)

  @@index([empreendimentoId])
  @@map("contato")
}

model Cadastur {
  id               Int            @id @default(autoincrement())
  empreendimentoId Int            @map("empreendimento_id")
  /// nao_possui, igual_cnpj ou numero_proprio
  situacao         String
  numero           String?
  vencimento       DateTime?      @db.Date
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Restrict)

  @@index([empreendimentoId])
  @@map("cadastur")
}

model Usuario {
  id                 Int                     @id @default(autoincrement())
  nome               String
  email              String                  @unique
  /// administrador, gestor, estagiario, visualizador ou empresario
  perfil             String
  ativo              Boolean                 @default(true)
  empreendimentos    UsuarioEmpreendimento[]
  inventariosCriados InventarioVersao[]
  catalogoVersoes    CatalogoItemVersao[]
  respostas          Resposta[]
  auditorias         Auditoria[]
  credencial         CredencialLocal?
  sessoes            Sessao[]
  ativacoes          AtivacaoConta[]

  @@map("usuario")
}

model CredencialLocal {
  usuarioId Int     @id @map("usuario_id")
  senhaHash String  @map("senha_hash")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@map("credencial_local")
}

model Sessao {
  tokenHash  String    @id @map("token_hash")
  usuarioId  Int       @map("usuario_id")
  criadaEm   DateTime  @map("criada_em") @db.Timestamptz(6)
  expiraEm   DateTime  @map("expira_em") @db.Timestamptz(6)
  revogadaEm DateTime? @map("revogada_em") @db.Timestamptz(6)
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@map("sessao")
}

model AtivacaoConta {
  tokenHash String    @id @map("token_hash")
  usuarioId Int       @map("usuario_id")
  expiraEm  DateTime  @map("expira_em") @db.Timestamptz(6)
  usadaEm   DateTime? @map("usada_em") @db.Timestamptz(6)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@map("ativacao_conta")
}

model LimiteAutenticacao {
  chave      String   @id
  tentativas Int
  expiraEm   DateTime @map("expira_em") @db.Timestamptz(6)

  @@index([expiraEm])
  @@map("limite_autenticacao")
}

model UsuarioEmpreendimento {
  usuarioId        Int            @map("usuario_id")
  empreendimentoId Int            @map("empreendimento_id")
  ativo            Boolean        @default(true)
  usuario          Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Restrict)

  @@id([usuarioId, empreendimentoId])
  @@index([empreendimentoId])
  @@map("usuario_empreendimento")
}

model CatalogoGrupo {
  id           Int            @id @default(autoincrement())
  segmentoId   Int            @map("segmento_id")
  chave        String         @unique
  pergunta     String
  /// unica ou multipla
  selecao      String
  permiteOutro Boolean        @map("permite_outro")
  ordem        Int
  /// Seção do formulário (ex.: Recepção, A&B, Acessibilidade); agrupa perguntas na tela.
  secao        String?
  /// Grupo inativo não é oferecido a novas respostas; valores históricos permanecem legíveis.
  ativo        Boolean        @default(true)
  segmento     Segmento       @relation(fields: [segmentoId], references: [id], onDelete: Restrict)
  itens        CatalogoItem[]

  @@index([segmentoId])
  @@map("catalogo_grupo")
}

model CatalogoItem {
  id               Int                  @id @default(autoincrement())
  grupoId          Int                  @map("grupo_id")
  chave            String               @unique
  rotulo           String
  exclusivo        Boolean
  /// Item "Outro(s)": exige texto de detalhe quando marcado como sim.
  outro            Boolean              @default(false)
  /// Item que admite quantidade (inteiro >= 0) além do estado.
  aceitaQuantidade Boolean              @default(false) @map("aceita_quantidade")
  ordem            Int
  ativo            Boolean              @default(true)
  /// Número da versão vigente; o snapshot completo fica em `CatalogoItemVersao`.
  versaoAtual      Int                  @default(1) @map("versao_atual")
  grupo            CatalogoGrupo        @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  inventarios      InventarioItem[]
  versoes          CatalogoItemVersao[]

  @@index([grupoId])
  @@map("catalogo_item")
}

/// Snapshot imutável do item e das regras do grupo no momento de cada alteração.
/// Inventários referenciam (item, versão) para que editar o catálogo não mude a leitura histórica.
model CatalogoItemVersao {
  itemId           Int              @map("item_id")
  numero           Int
  rotulo           String
  pergunta         String
  /// unica ou multipla
  selecao          String
  exclusivo        Boolean
  outro            Boolean
  aceitaQuantidade Boolean          @map("aceita_quantidade")
  criadaEm         DateTime         @map("criada_em") @db.Timestamp(6)
  /// Nulo na carga inicial (sem usuário autenticado).
  criadaPor        Int?             @map("criada_por")
  motivo           String?
  item             CatalogoItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  criador          Usuario?         @relation(fields: [criadaPor], references: [id], onDelete: Restrict)
  inventarios      InventarioItem[]

  @@id([itemId, numero])
  @@map("catalogo_item_versao")
}

model InventarioVersao {
  id                  Int                        @id @default(autoincrement())
  empreendimentoId    Int                        @map("empreendimento_id")
  criadaPor           Int                        @map("criada_por")
  vigenciaInicio      DateTime                   @map("vigencia_inicio") @db.Date
  vigenciaFim         DateTime?                  @map("vigencia_fim") @db.Date
  /// correcao ou mudanca_real
  tipoAlteracao       String                     @map("tipo_alteracao")
  /// completo, parcial ou pendente
  situacaoConferencia String                     @map("situacao_conferencia")
  totalUh             Int?                       @map("total_uh")
  leitos              Int?
  maxLeitosPorUh      Int?                       @map("max_leitos_por_uh")
  uhsPcd              Int?                       @map("uhs_pcd")
  funcFixos           Int?                       @map("func_fixos")
  funcTemporarios     Int?                       @map("func_temporarios")
  checkin             DateTime?                  @db.Time(6)
  checkout            DateTime?                  @db.Time(6)
  funciona24h         Boolean?                   @map("funciona_24h")
  criadaEm            DateTime                   @default(now()) @map("criada_em") @db.Timestamp(6)
  /// Justificativa livre da versão (ex.: motivo da correção).
  motivo              String?
  /// Estado de cada campo de capacidade que não é "informado": nao_se_aplica, desconhecido ou vazio.
  /// A coluna escalar fica nula nesses casos; zero é sempre um valor informado.
  estados             Json                       @default("{}")
  /// Preenchido quando uma correção substitui esta versão no mesmo intervalo; a linha é preservada.
  substituidaPorId    Int?                       @map("substituida_por_id")
  empreendimento      Empreendimento             @relation(fields: [empreendimentoId], references: [id], onDelete: Restrict)
  criador             Usuario                    @relation(fields: [criadaPor], references: [id], onDelete: Restrict)
  substituidaPor      InventarioVersao?          @relation("Correcao", fields: [substituidaPorId], references: [id], onDelete: Restrict)
  corrige             InventarioVersao[]         @relation("Correcao")
  itens               InventarioItem[]
  resultados          IndicadorResultadoVersao[]

  @@index([empreendimentoId, vigenciaInicio])
  @@index([criadaPor])
  @@index([substituidaPorId])
  @@map("inventario_versao")
}

model InventarioItem {
  versaoId   Int                @map("versao_id")
  itemId     Int                @map("item_id")
  /// sim, nao, nao_se_aplica ou nao_informado
  estado     String
  detalhe    String?
  quantidade Int?
  /// Versão do item usada nesta resposta (snapshot imutável).
  itemVersao Int                @default(1) @map("item_versao")
  versao     InventarioVersao   @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  item       CatalogoItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  snapshot   CatalogoItemVersao @relation(fields: [itemId, itemVersao], references: [itemId, numero], onDelete: Restrict)

  @@id([versaoId, itemId])
  @@index([itemId])
  @@map("inventario_item")
}

model PesquisaModelo {
  id          Int                  @id @default(autoincrement())
  nome        String
  publicoAlvo String               @map("publico_alvo")
  /// Número da versão vigente; o snapshot completo está em PesquisaModeloVersao.
  versaoAtual Int                  @default(1) @map("versao_atual")
  criadaEm    DateTime             @default(now()) @map("criada_em") @db.Timestamp(6)
  pesquisas   Pesquisa[]
  campos      PesquisaCampo[]
  versoes     PesquisaModeloVersao[]

  @@map("pesquisa_modelo")
}

/// Snapshot imutável da estrutura do modelo a cada alteração semântica.
model PesquisaModeloVersao {
  modeloId    Int                  @map("modelo_id")
  numero      Int
  nome        String
  publicoAlvo String               @map("publico_alvo")
  criadaEm    DateTime             @default(now()) @map("criada_em") @db.Timestamp(6)
  criadaPor   Int?                 @map("criada_por")
  motivo      String?
  modelo      PesquisaModelo       @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  campos      PesquisaCampoVersao[]
  pesquisas   Pesquisa[]

  @@id([modeloId, numero])
  @@map("pesquisa_modelo_versao")
}

/// Snapshot imutável de um campo do modelo na composição de cada versão.
model PesquisaCampoVersao {
  modeloId    Int                  @map("modelo_id")
  numero      Int
  /// Identificador do campo vivo no momento do snapshot; não é FK para preservar o histórico.
  campoId     Int                  @map("campo_id")
  chave       String
  rotulo      String
  /// percentual, texto ou escolha
  tipoValor   String               @map("tipo_valor")
  obrigatorio Boolean
  ordem       Int
  /// Opções da época, como [{ chave, rotulo, ordem }]; null quando não é campo de escolha.
  opcoes      Json?
  versao      PesquisaModeloVersao @relation(fields: [modeloId, numero], references: [modeloId, numero], onDelete: Restrict)

  @@id([modeloId, numero, campoId])
  @@map("pesquisa_campo_versao")
}

/// Edição de pesquisa. A estrutura fica congelada na versão do modelo escolhida na criação.
model Pesquisa {
  id                         Int                    @id @default(autoincrement())
  modeloId                   Int                    @map("modelo_id")
  /// Versão do modelo usada pela edição (snapshot imutável).
  modeloVersao               Int                    @map("modelo_versao")
  titulo                     String
  /// expectativa ou consolidado
  tipoColeta                 String                 @map("tipo_coleta")
  /// Instantes em UTC; a interface opera no fuso America/Sao_Paulo.
  abertura                   DateTime               @db.Timestamp(6)
  prazo                      DateTime               @db.Timestamp(6)
  /// rascunho, aberta ou encerrada (CHECK na migration). Agendada/expirada são derivadas do relógio.
  status                     String
  /// Filtro de público por segmento; vazio = todos os segmentos.
  segmentoIds                Int[]                  @default([]) @map("segmento_ids")
  criadaEm                   DateTime               @default(now()) @map("criada_em") @db.Timestamp(6)
  abertaEm                   DateTime?              @map("aberta_em") @db.Timestamp(6)
  encerradaEm                DateTime?              @map("encerrada_em") @db.Timestamp(6)
  /// Momento em que o público foi congelado; nulo nas edições anteriores à parte 12.
  destinatariosRegistradosEm DateTime?              @map("destinatarios_registrados_em") @db.Timestamp(6)
  modelo                     PesquisaModelo         @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  versao                     PesquisaModeloVersao   @relation(fields: [modeloId, modeloVersao], references: [modeloId, numero], onDelete: Restrict)
  perguntas                  PesquisaPergunta[]
  respostas                  Resposta[]
  destinatarios              PesquisaDestinatario[]
  eventos                    PesquisaEvento[]

  @@index([modeloId])
  @@index([modeloId, modeloVersao])
  @@map("pesquisa")
}

/// Público congelado na abertura: denominador estável da participação.
model PesquisaDestinatario {
  pesquisaId       Int            @map("pesquisa_id")
  empreendimentoId Int            @map("empreendimento_id")
  incluidoEm       DateTime       @default(now()) @map("incluido_em") @db.Timestamp(6)
  pesquisa         Pesquisa       @relation(fields: [pesquisaId], references: [id], onDelete: Restrict)
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Restrict)

  @@id([pesquisaId, empreendimentoId])
  @@index([empreendimentoId])
  @@map("pesquisa_destinatario")
}

/// Caixa de saída de eventos da pesquisa (consumida pela parte 14); um evento por tipo.
model PesquisaEvento {
  id           Int       @id @default(autoincrement())
  pesquisaId   Int       @map("pesquisa_id")
  /// aberta (CHECK na migration)
  tipo         String
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamp(6)
  processadoEm DateTime? @map("processado_em") @db.Timestamp(6)
  pesquisa     Pesquisa  @relation(fields: [pesquisaId], references: [id], onDelete: Restrict)

  @@unique([pesquisaId, tipo])
  @@index([processadoEm])
  @@map("pesquisa_evento")
}

model PesquisaCampo {
  id          Int                  @id @default(autoincrement())
  modeloId    Int                  @map("modelo_id")
  chave       String
  rotulo      String
  /// percentual, texto ou escolha
  tipoValor   String               @map("tipo_valor")
  obrigatorio Boolean
  ordem       Int
  modelo      PesquisaModelo       @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  opcoes      PesquisaCampoOpcao[]
  perguntas   PesquisaPergunta[]

  @@index([modeloId])
  @@map("pesquisa_campo")
}

/// Opção de campo de escolha; pertence ao campo vivo e entra no snapshot da versão.
model PesquisaCampoOpcao {
  id      Int           @id @default(autoincrement())
  campoId Int           @map("campo_id")
  chave   String
  rotulo  String
  ordem   Int
  campo   PesquisaCampo @relation(fields: [campoId], references: [id], onDelete: Cascade)

  @@unique([campoId, chave])
  @@map("pesquisa_campo_opcao")
}

model PesquisaPergunta {
  id         Int            @id @default(autoincrement())
  pesquisaId Int            @map("pesquisa_id")
  campoId    Int            @map("campo_id")
  periodoId  Int            @map("periodo_id")
  rotulo     String
  pesquisa   Pesquisa       @relation(fields: [pesquisaId], references: [id], onDelete: Restrict)
  campo      PesquisaCampo  @relation(fields: [campoId], references: [id], onDelete: Restrict)
  periodo    Periodo        @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  respostas  RespostaItem[]

  @@index([pesquisaId])
  @@index([campoId])
  @@index([periodoId])
  @@map("pesquisa_pergunta")
}

model Resposta {
  id               Int            @id @default(autoincrement())
  pesquisaId       Int            @map("pesquisa_id")
  empreendimentoId Int            @map("empreendimento_id")
  usuarioId        Int            @map("usuario_id")
  respondidaEm     DateTime       @map("respondida_em") @db.Timestamp(6)
  /// sistema ou importacao
  canal            String
  pesquisa         Pesquisa       @relation(fields: [pesquisaId], references: [id], onDelete: Restrict)
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Restrict)
  usuario          Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  itens            RespostaItem[]

  @@unique([pesquisaId, empreendimentoId])
  @@index([empreendimentoId])
  @@index([usuarioId])
  @@map("resposta")
}

model RespostaItem {
  respostaId    Int              @map("resposta_id")
  perguntaId    Int              @map("pergunta_id")
  valorNumerico Decimal?         @map("valor_numerico") @db.Decimal
  valorTexto    String?          @map("valor_texto")
  resposta      Resposta         @relation(fields: [respostaId], references: [id], onDelete: Restrict)
  pergunta      PesquisaPergunta @relation(fields: [perguntaId], references: [id], onDelete: Restrict)

  @@id([respostaId, perguntaId])
  @@index([perguntaId])
  @@map("resposta_item")
}

model Auditoria {
  id           Int      @id @default(autoincrement())
  usuarioId    Int?     @map("usuario_id")
  autorNome    String?  @map("autor_nome")
  origem       String   @default("manual")
  processo     String?
  correlacaoId String?  @map("correlacao_id")
  entidade     String
  entidadeId   Int      @map("entidade_id")
  acao         String
  antes        Json?    @db.JsonB
  depois       Json?    @db.JsonB
  em           DateTime @default(now()) @db.Timestamp(6)
  usuario      Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([em, id])
  @@index([correlacaoId])
  @@map("auditoria")
}

model Periodo {
  id             Int                  @id @default(autoincrement())
  /// mes ou feriado_prolongado
  tipo           String
  rotulo         String
  dataInicio     DateTime             @map("data_inicio") @db.Date
  /// Quantidade de dias = dataFim - dataInicio + 1; não é persistida.
  dataFim        DateTime             @map("data_fim") @db.Date
  perguntas      PesquisaPergunta[]
  coletasDiarias ColetaDiaria[]
  resultados     IndicadorResultado[]
  rhc            RhcPeriodo[]

  /// Identidade canônica: mesmo tipo e intervalo não podem se repetir
  /// (regra sujeita à confirmação do OTO; sobreposição entre tipos é permitida).
  @@unique([tipo, dataInicio, dataFim])
  @@map("periodo")
}

model ColetaDiaria {
  id               Int            @id @default(autoincrement())
  empreendimentoId Int            @map("empreendimento_id")
  periodoId        Int            @map("periodo_id")
  /// booking ou empresario
  fonte            String
  dataColeta       DateTime       @map("data_coleta") @db.Date
  dataEstadia      DateTime       @map("data_estadia") @db.Date
  /// semana ou fim_de_semana
  tipoDia          String         @map("tipo_dia")
  valorDiaria      Decimal        @map("valor_diaria") @db.Decimal
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Restrict)
  periodo          Periodo        @relation(fields: [periodoId], references: [id], onDelete: Restrict)

  @@index([empreendimentoId, periodoId])
  @@index([periodoId])
  @@map("coleta_diaria")
}

model IndicadorDefinicao {
  id               Int                           @id @default(autoincrement())
  codigo           String                        @unique
  nome             String
  unidade          String
  formulaDescricao String                        @map("formula_descricao")
  versaoFormula    Int                           @map("versao_formula")
  resultados       IndicadorResultado[]
  visibilidades    VisibilidadeIndicadorPerfil[]

  @@map("indicador_definicao")
}

model PermissaoPerfil {
  perfil  String
  recurso String
  acao    String
  escopo  String

  @@id([perfil, recurso, acao])
  @@map("permissao_perfil")
}

model VisibilidadeIndicadorPerfil {
  perfil      String
  indicadorId Int                @map("indicador_id")
  permitido   Boolean            @default(false)
  indicador   IndicadorDefinicao @relation(fields: [indicadorId], references: [id], onDelete: Restrict)

  @@id([perfil, indicadorId])
  @@index([indicadorId])
  @@map("visibilidade_indicador_perfil")
}

model PoliticaAcesso {
  id      Int @id
  revisao Int @default(1)

  @@map("politica_acesso")
}

model IndicadorResultado {
  id          Int                           @id @default(autoincrement())
  definicaoId Int                           @map("definicao_id")
  periodoId   Int                           @map("periodo_id")
  /// expectativa ou consolidado
  tipoColeta  String                        @map("tipo_coleta")
  /// hotel, resort, pousada ou total
  recorte     String
  /// aritmetica ou ponderada
  metodo      String
  valor       Decimal                       @db.Decimal
  calculadoEm DateTime                      @map("calculado_em") @db.Timestamp(6)
  definicao   IndicadorDefinicao            @relation(fields: [definicaoId], references: [id], onDelete: Restrict)
  periodo     Periodo                       @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  versoes     IndicadorResultadoVersao[]
  parametros  IndicadorResultadoParametro[]

  @@index([definicaoId, periodoId])
  @@index([periodoId])
  @@map("indicador_resultado")
}

model IndicadorResultadoVersao {
  resultadoId Int                @map("resultado_id")
  versaoId    Int                @map("versao_id")
  resultado   IndicadorResultado @relation(fields: [resultadoId], references: [id], onDelete: Restrict)
  versao      InventarioVersao   @relation(fields: [versaoId], references: [id], onDelete: Restrict)

  @@id([resultadoId, versaoId])
  @@index([versaoId])
  @@map("indicador_resultado_versao")
}

model ParametroCalculo {
  id             Int                           @id @default(autoincrement())
  chave          String
  valor          Decimal                       @db.Decimal
  vigenciaInicio DateTime                      @map("vigencia_inicio") @db.Date
  vigenciaFim    DateTime?                     @map("vigencia_fim") @db.Date
  fonte          String?
  resultados     IndicadorResultadoParametro[]

  @@map("parametro_calculo")
}

model IndicadorResultadoParametro {
  resultadoId Int                @map("resultado_id")
  parametroId Int                @map("parametro_id")
  resultado   IndicadorResultado @relation(fields: [resultadoId], references: [id], onDelete: Restrict)
  parametro   ParametroCalculo   @relation(fields: [parametroId], references: [id], onDelete: Restrict)

  @@id([resultadoId, parametroId])
  @@index([parametroId])
  @@map("indicador_resultado_parametro")
}

model RhcPeriodo {
  id        Int     @id @default(autoincrement())
  periodoId Int     @map("periodo_id")
  qtdRhc    Int     @map("qtd_rhc")
  leitos    Int
  periodo   Periodo @relation(fields: [periodoId], references: [id], onDelete: Restrict)

  @@index([periodoId])
  @@map("rhc_periodo")
}
